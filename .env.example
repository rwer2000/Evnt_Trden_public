# Copy to .env for local development. In GitHub Actions, set these as
# repository secrets instead (Settings -> Secrets and variables -> Actions).

# Postgres connection for the dedicated `congress_app` role (scoped to the
# `congress` schema only, see docs/plan-van-aanpak.md section 2.5).
DATABASE_URL=postgresql://congress_app:<password>@db.pcpdttjwowhrzlltnyuw.supabase.co:5432/postgres

# Cloudflare R2 (S3-compatible object storage): the `congress-raw` raw
# archive and `congress-backups` buckets. Moved off Supabase Storage once
# the raw archive outgrew its free 1 GB quota (shared with the unrelated
# Sportlogging app in the same Supabase project) -- see README's
# "Database & storage" section. The access key/secret pair comes from an
# R2 API token scoped to these two buckets only (Cloudflare dashboard ->
# R2 -> Manage API tokens), not the account-wide Cloudflare API key.
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>

# Optional: the free-tier budget guard's ceiling in bytes (see README's
# "Staying under R2's free tier" section). Defaults to 9 GiB if unset --
# only override this if you've moved to a paid R2 plan with more room.
# R2_STORAGE_CEILING_BYTES=9663676416

# Only needed to run `ops.migrate_raw_archive_to_r2` (the one-time copy
# from Supabase Storage to R2) or to re-run it later -- not needed for
# regular local dev once the migration has happened. Same project as
# DATABASE_URL; the service_role secret key from Project Settings -> API
# keys in the Supabase dashboard. It bypasses all Storage/RLS restrictions
# for the whole project, not just this bucket, so treat it as highly
# sensitive and never log it.
SUPABASE_URL=https://pcpdttjwowhrzlltnyuw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# Bot token from @BotFather, and the target chat's id (a negative number
# for a group). Used for new-filing/error notifications (T12).
TELEGRAM_BOT_TOKEN=<bot-token>
TELEGRAM_CHAT_ID=<chat-id>
